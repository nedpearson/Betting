# ==============================================================================
# Betting Intelligence OS (BOI) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your local settings.
# LIVE means LIVE: Never commit real API keys or passphrases to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Execution Mode & Bankroll Settings
# ------------------------------------------------------------------------------
# Available modes:
#   intelligence_only : Generates signals and recommendations without executing orders (Default).
#   paper             : Simulates fills against real live Kalshi orderbooks.
#   live              : Submits real orders with real funds to Kalshi (Requires Triple Lock).
BOI_MODE=intelligence_only

# Starting bankroll for position sizing and portfolio risk tracking (Default: $500.00)
BOI_BANKROLL=500.00

# ------------------------------------------------------------------------------
# 2. Triple-Lock Live Execution Safety Gating
# ------------------------------------------------------------------------------
# In order for live orders to be submitted to Kalshi, ALL THREE conditions must be met:
# 1. BOI_MODE=live
# 2. BOI_LIVE_EXECUTION_CONFIRMED=I_UNDERSTAND_REAL_MONEY_IS_AT_RISK
# 3. Valid Kalshi API Credentials with signed cryptographic headers
BOI_LIVE_EXECUTION_CONFIRMED=""

# Optional admin bearer token required for critical mutating endpoints (e.g. kill switch, manual orders)
BOI_ADMIN_TOKEN=""

# ------------------------------------------------------------------------------
# 3. Kalshi Exchange API Credentials
# ------------------------------------------------------------------------------
# Public market data (REST quotes, markets, candlesticks) works WITHOUT keys.
# Authenticated endpoints (private portfolio, orders, authenticated WS) require an API key:
BOI_KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
BOI_KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
BOI_KALSHI_KEY_ID=""

# Path to your Ed25519 or RSA private key PEM file (recommended) OR raw PEM string
BOI_KALSHI_PRIVATE_KEY_PATH=""

# Fee tier configuration:
#   retail : Rounded up to nearest $0.01 per contract tier (Default)
#   member : Direct member $0.0001 precision
BOI_KALSHI_FEE_TIER=retail

# ------------------------------------------------------------------------------
# 4. External Data Source Credentials
# ------------------------------------------------------------------------------
# Federal Reserve Economic Data (FRED) API Key (Free registration at https://fred.stlouisfed.org/)
BOI_FRED_API_KEY=""

# Coinbase Exchange REST Base URL (Public spot data requires no key)
BOI_COINBASE_API_BASE=https://api.exchange.coinbase.com

# Open-Meteo Ensemble & Weather (Open access, no key required)
BOI_OPEN_METEO_BASE=https://ensemble-api.open-meteo.com/v1/ensemble

# BallDontLie or Sports Radar API Key (Optional, for NBA/NFL advanced box scores)
BOI_BALLDONTLIE_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Risk Governor & Capital Preservation Policy
# ------------------------------------------------------------------------------
# Hard limits enforced with absolute veto power by Agent 11 (Portfolio Risk Manager)
BOI_MAX_TRADE_RISK_PCT=0.01        # Max 1.0% of bankroll per single trade ($5.00 on $500)
BOI_MAX_OPEN_RISK_PCT=0.10         # Max 10.0% aggregate open portfolio risk ($50.00 on $500)
BOI_MAX_DAILY_LOSS_PCT=0.03        # Circuit breaker: halt new trades on 3% daily drawdown ($15.00)
BOI_MAX_DRAWDOWN_PCT=0.10          # Emergency halt on 10% peak-to-trough drawdown ($50.00)
BOI_KELLY_FRACTION=0.25            # Conservative quarter-Kelly multiplier (f* = 0.25)
BOI_MIN_CONSERVATIVE_EDGE=0.04     # Minimum 4.0% edge at 95% lower bound after all fees
BOI_MAX_ORDER_BOOK_IMPACT_PCT=0.20 # Maximum 20% consumption of resting top-of-book depth

# ------------------------------------------------------------------------------
# 6. Database & Networking
# ------------------------------------------------------------------------------
BOI_DB_URL=sqlite+aiosqlite:///data/boi.db
BOI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
